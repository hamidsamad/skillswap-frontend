# Backend API Base URL
# For local development using Vite proxy (default): leave empty
# For production (e.g. Vercel deployment): set to your deployed backend service URL
# VITE_API_URL=https://your-backend-api.onrender.com

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console (Web application type)
# Authorized JavaScript origins: http://localhost:5173, https://skillsswap67.vercel.app
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
